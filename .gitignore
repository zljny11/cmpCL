# Ignore everything at the repo root by default.
/*

# Keep the Git metadata files tracked.
!/.gitignore

# Only include the AICampCloud frontend and backend projects.
!/campcloud-server/
!/campcloud-web/
!/scripts/
!/scripts/start-campcloud-dev.sh
!/scripts/stop-campcloud-dev.sh

# Ignore common generated files inside the included projects.
campcloud-server/node_modules/
campcloud-server/dist/
campcloud-server/.env
campcloud-server/*.tsbuildinfo

campcloud-web/node_modules/
campcloud-web/dist/
campcloud-web/.env
campcloud-web/*.tsbuildinfo

# macOS / editor noise
.DS_Store
